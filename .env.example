NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose this to the browser — bypasses Row Level
# Security. Used only by src/app/api/inquiries/route.ts.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only. Resend (https://resend.com) transactional email.
RESEND_API_KEY=
RESEND_FROM_EMAIL="BizLink Africa <notifications@bizlinkafrica.net>"
# The only recipient of inquiry notification emails. Do not add additional
# notification recipients (e.g. info@ or support@) — see src/lib/email/resend.ts.
BIZLINK_NOTIFICATION_EMAIL=ceo@bizlinkafrica.net
