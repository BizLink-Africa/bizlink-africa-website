# ============================================================
# PUBLIC BROWSER VARIABLES
# Safe to ship in the client bundle. Never put a secret in this section —
# anything prefixed NEXT_PUBLIC_ is readable by anyone who opens dev tools.
# ============================================================

# The public marketing site's own URL.
# Local dev: http://localhost:3000 — Production: https://bizlinkafrica.net
NEXT_PUBLIC_SITE_URL=

# The admin portal's URL — a separate host from the public site (see
# src/proxy.ts for the host-separation logic). Used to build links in
# staff-invite and internal-notification emails so they resolve on the
# admin host rather than 404ing against the public host's /admin/* block.
# Local dev: http://localhost:3000 — Production: https://admin.bizlinkafrica.net
NEXT_PUBLIC_ADMIN_URL=

# PostHog product analytics. The project token is browser-safe (publishable)
# and the same value is reused server-side by src/lib/posthog-server.ts.
# Local dev + Production: see https://app.posthog.com → Project settings.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

NEXT_PUBLIC_SUPABASE_URL=
# Supabase's browser-safe publishable/anon key — safe here specifically
# because every table it can reach is behind Row Level Security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ============================================================
# SERVER-ONLY VARIABLES
# Never prefix these with NEXT_PUBLIC_ (or any client-exposed equivalent).
# Only read from server components, server actions, and route handlers —
# see src/lib/supabase/service.ts, which is guarded by `import 'server-only'`
# specifically so a client-component import fails the build instead of
# silently shipping this key to the browser.
# ============================================================

# Bypasses Row Level Security entirely. Used by:
# src/app/api/inquiries/route.ts, src/app/admin/login/actions.ts,
# src/app/admin/(protected)/staff/actions.ts (via src/lib/supabase/service.ts).
SUPABASE_SERVICE_ROLE_KEY=

# Resend (https://resend.com) transactional email.
RESEND_API_KEY=
RESEND_FROM_EMAIL="BizLink Africa <notifications@bizlinkafrica.net>"
# The only recipient of inquiry notification emails. Do not add additional
# notification recipients (e.g. info@ or support@) — see src/lib/email/resend.ts.
BIZLINK_NOTIFICATION_EMAIL=ceo@bizlinkafrica.net

# Symmetric key passed into the insert_provisioning_credential() Postgres
# function to encrypt Client Provisioning API keys/webhook secrets at rest
# (pgcrypto pgp_sym_encrypt). Never logged, never sent to the browser, and
# there is no corresponding decrypt path in the app — losing this key means
# existing encrypted credentials can never be recovered, only replaced.
PROVISIONING_ENCRYPTION_KEY=

# Symmetric key passed into the request_merchant_beneficiary_change()
# Postgres function to encrypt settlement beneficiary destination values
# (bank account / mobile wallet numbers) at rest (pgcrypto pgp_sym_encrypt).
# Same never-logged, never-browser-sent, no-decrypt-path contract as
# PROVISIONING_ENCRYPTION_KEY above — only masked_destination_value is ever
# read back by the app. Losing this key means existing encrypted
# destination values can never be recovered, only replaced.
BENEFICIARY_ENCRYPTION_KEY=

# ============================================================
# SELCOM BUSINESS API (see src/lib/selcom/)
# Sandbox and production are two FULLY SEPARATE credential sets below —
# never reuse a sandbox value for production or vice versa. Going live
# requires BOTH SELCOM_ENV=production AND
# SELCOM_PRODUCTION_ACTIVATION_ENABLED=true to be set — a deliberate,
# two-flag deployment change, never a side effect of anything this app
# does at runtime (see src/lib/selcom/config.ts's
# resolveSelcomEnvironment()). Before ever setting those two flags on a
# real deployment, complete the checklist and Finance/Compliance approval
# at Administration -> Integrations -> Disbursement API -> Production
# Readiness. Set these two flags ONLY on the one authorised Vercel
# Production environment — never on Preview, never in a local .env file
# (this repo's .gitignore excludes every `.env*` file except .env.example,
# so nothing here is ever committed — keep it that way, and never paste a
# real production secret into this file even locally). Production secrets
# belong only in Vercel's encrypted project env vars or an approved secret
# manager, never in a local .env file at all, committed or not.
#
# Never place any of these in a NEXT_PUBLIC_ variable or in frontend code —
# every file under src/lib/selcom/ starts with `import 'server-only'`
# specifically so a client-component import fails the build instead of
# shipping a credential to the browser.
# ============================================================

SELCOM_ENV=sandbox

# The second, independent flag required (with SELCOM_ENV=production) to
# actually go live. Defaults to unset/false — "production activation must
# be disabled by default". Leave unset everywhere except the one
# authorised production deployment.
SELCOM_PRODUCTION_ACTIVATION_ENABLED=false

# Deployment-level master switch for the whole integration — required for
# EVERY environment (sandbox included), independent of and in addition to
# the DB-backed kill switch at Administration -> Integrations ->
# Disbursement API. Safe to set true for local sandbox development; the
# next flag is the one that actually matters for real funds.
SELCOM_INTEGRATION_ENABLED=false

# The single most important flag in this integration. Gates ONLY
# production disbursement (POST /v1/transaction/process) — sandbox never
# needs it, since sandbox never moves real funds. Must remain false/unset
# until the full Production Readiness checklist (Administration ->
# Integrations -> Disbursement API -> Production Readiness) and Finance +
# Compliance approval are recorded, and even then, flipping this is a
# separate, deliberate deployment decision — never a side effect of
# anything this app does at runtime.
SELCOM_LIVE_PAYOUTS_ENABLED=false

# Confirms the current business model: BizLink Africa provides ICT
# infrastructure, onboarding coordination, integrations and technical
# support only. It does not receive, hold, control, reconcile, disburse or
# settle merchant funds — each merchant manages their own payment account
# and settles directly with their approved payment partner. This is a
# permanent business-model decision, not a bypassable toggle: leave unset
# (defaults to false/blocked) and do not set to true — every disbursement
# and archived-financial-prototype code path blocks unconditionally
# regardless of this flag's value. See src/lib/archived-financial-prototype.ts.
BIZLINK_MANAGES_MERCHANT_SETTLEMENTS=false

SELCOM_SANDBOX_BASE_URL=https://sandbox.selcom.business
SELCOM_PRODUCTION_BASE_URL=https://api.selcom.business/v1

# ── Sandbox credential set ──────────────────────────────────
# Issued by Selcom for your sandbox account. Sent as the `api-key` header —
# never logged in full (see src/lib/selcom/client.ts's redactForLog).
SELCOM_API_KEY=

# PEM-format RSA private key used to sign every request (RSA-SHA256,
# producing the `digest` header) per developer.selcom.business's
# Authorization scheme. If your secret store can't hold real newlines,
# literal "\n" sequences are normalized back to newlines automatically
# (see src/lib/selcom/config.ts). Never logged, never sent to the browser,
# never committed.
SELCOM_RSA_PRIVATE_KEY=

# The Selcom account number disbursements are made from — used as the
# default `account_number` for balance lookups (src/lib/selcom/balance.ts).
SELCOM_DISBURSEMENT_ACCOUNT=

# Secret path segment for the inbound Selcom callback route — see
# src/app/api/integrations/selcom/callback/[secret]/route.ts. Selcom's
# callback documentation defines no signature/HMAC scheme, so this
# unguessable path segment (checked with a constant-time comparison) plus
# reference/amount/destination/state matching in
# process_selcom_callback() is the protection instead. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SELCOM_CALLBACK_SECRET=

# The HTTPS endpoint registered with Selcom's merchant portal to receive
# transaction callbacks. Must end with
# /api/integrations/selcom/callback/<SELCOM_CALLBACK_SECRET above>. This is
# an out-of-band registration with Selcom — setting this env var alone does
# not register anything on Selcom's side.
SELCOM_CALLBACK_URL=

# ── Production credential set — fully separate from sandbox above.
# Generate distinct production credentials with Selcom; never copy a
# sandbox value here. Only ever set these in Vercel's Production
# environment (or an approved secret manager), never locally. ───────────
SELCOM_PRODUCTION_API_KEY=
SELCOM_PRODUCTION_RSA_PRIVATE_KEY=
SELCOM_PRODUCTION_DISBURSEMENT_ACCOUNT=
SELCOM_PRODUCTION_CALLBACK_SECRET=
SELCOM_PRODUCTION_CALLBACK_URL=

# Protects src/app/api/payouts/status-check-cron/route.ts from being
# triggered by anyone other than Vercel's own cron scheduler. Vercel
# automatically sends this as `Authorization: Bearer <value>` on
# cron-triggered requests once set as a project env var — see
# vercel.json's `crons` entry and
# https://vercel.com/docs/cron-jobs/manage-cron-jobs#securing-cron-jobs.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CRON_SECRET=
